    CONTRACT |o--o{ CUSTOMER_CASE : "предмет"
    ACCOUNT |o--o{ CUSTOMER_CASE : "предмет"
    CARD |o--o{ CUSTOMER_CASE : "предмет"
    PAYMENT |o--o{ CUSTOMER_CASE : "предмет"
