    ACCOUNT ||--o{ CARD : "привязана"
    PARTY ||--o{ CARD : "держатель"
    ACCOUNT ||--o{ PAYMENT : "счёт плательщика"
    ACCOUNT ||--o{ TRANSACTION : "движение"
    CARD |o--o{ TRANSACTION : "карточные операции"
    PAYMENT |o--o{ TRANSACTION : "исполнен"
